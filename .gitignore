# Claude session files — never commit these
*.jsonl
*.jsonl.gz
.claude/projects/

# OS files
.DS_Store
Thumbs.db

# Node
node_modules/

# Scraper snapshot data (monthly JSON files) — ignore the folder's contents,
# but keep the hand-maintained override files tracked (they must ship so the
# CI scrape and photo fetch apply them).
scripts/data/*
!scripts/data/photo_overrides.json
!scripts/data/variant_overrides.json
email-preview.html
# Generated email preview artifact (rebuilt by scripts/_build_preview.py)
scripts/email-template-v2-preview.html

# Internal build artifacts — must never be published as static assets
jdm-eligibility-rebuild.zip
redesign-prototype.html

# Email config with secrets
scripts/email_config.json

# Local caches / build dirs
.wrangler/
scripts/__pycache__/
__pycache__/

# Local Python virtualenv (for running the scraper locally)
.venv/

# Backups (timestamped data.json + template .bak files)
*.bak
*.bak-*
